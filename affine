# affine — thin launcher for the affine-skill CLI. Ensures the venv, then dispatches.
#
# The venv is built from the first CPython >= 3.10 found among: $AFFINE_PYTHON,
# `python3` on PATH, the Homebrew / /usr/local interpreters, then versioned names.
# (pycrdt, the sole dependency, needs Python >= 3.10; macOS ships 3.9 as /usr/bin/python3.)
# A venv that can no longer import pycrdt is rebuilt automatically.
set -euo pipefail
SKILL_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
VENV="$SKILL_DIR/.venv"
MIN_MINOR=10

usable() {
  local py="$1"
  command -v "$py" >/dev/null 2>&1 || return 1
  "$py" -c "import sys; sys.exit(0 if sys.version_info >= (3, $MIN_MINOR) else 1)" >/dev/null 2>&1
}

find_python() {
  local c
  for c in "${AFFINE_PYTHON:-}" python3 /opt/homebrew/bin/python3 /usr/local/bin/python3 \
           python3.14 python3.13 python3.12 python3.11 python3.10; do
    [ -n "$c" ] || continue
    if usable "$c"; then
      command -v "$c"
      return 0
    fi
  done
  return 1
}

if ! "$VENV/bin/python" -c "import pycrdt" >/dev/null 2>&1; then
  rm -rf "$VENV"
  if ! PY="$(find_python)"; then
    echo "error: affine needs Python >= 3.$MIN_MINOR; none found." >&2
    echo "       Install one (e.g. 'brew install python') or set AFFINE_PYTHON=/path/to/python3." >&2
    exit 1
  fi
  "$PY" -m venv "$VENV" >/dev/null
  "$VENV/bin/pip" install --quiet --upgrade pip >/dev/null 2>&1 || true
  "$VENV/bin/pip" install --quiet -r "$SKILL_DIR/requirements.txt"
fi
exec env PYTHONPATH="$SKILL_DIR" "$VENV/bin/python" -m affine_local.cli "$@"
