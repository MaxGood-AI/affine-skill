# affine — entry point for the affine-skill CLI.
#
# Dependencies are declared inline (PEP 723), so there is no virtualenv, no
# requirements file, and no install step. The block below is the single source
# of truth for the dependency pin.
#
# Any PEP 723 runner works. With uv the dependency set is cached outside this
# directory — nothing is ever written into the skill folder, so the skill stays
# safe to sync, back up, or commit — and a conforming Python is fetched
# automatically if the host has none.
#
#   ./affine …                 # uv, via the shebang above
#   uv run --script affine …   # explicit, or where `env -S` is unavailable
#   python3 affine …           # any interpreter that can already import pycrdt
#
# /// script
# requires-python = ">=3.10"
# dependencies = ["pycrdt==0.14.1"]
# ///
"""Thin entry point: resolve the bundled package, then dispatch to its CLI."""

import pathlib
import sys

# affine_local ships alongside this file. PEP 723 covers such local, in-tree
# dependencies via sys.path rather than the dependency list above.
sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent))

from affine_local.cli import main

sys.exit(main())
